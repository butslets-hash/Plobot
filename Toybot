local function trim200(s)
    local n = utf8.len(s)
    if n and n > 200 then s = s:sub(1, utf8.offset(s, 201) - 1) end
    return s
end

local function clean(t)
    t = t:gsub("%*%*", "")
    t = t:gsub("\n%* ", "\n• ")
    t = t:gsub("^%* ", "• ")
    t = t:gsub("#+ ", "")
    return t
end

local function sfx(id, vol)
    if not id or id == "" then return end
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = vol or 0.5
    s.Parent = SoundService
    s:Play()
    Debris:AddItem(s, 6)
end

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function pad(o, l, t, r, b)
    return new("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b) }, o)
end

