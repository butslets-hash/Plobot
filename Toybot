-- SISTEMA DA IA
----------------------------------------------------------------
local AI = { mode = "medio" }

function AI.ask(system, contents, callback)
    if not httpRequest then
        return callback(nil, "Seu executor não tem a função request.")
    end
    if API_KEY == "" then
        return callback(nil, "Falta a API key.")
    end
    local done = false
    local function finish(text, err)
        if done then return end
        done = true
        callback(text, err)
    end
    task.delay(TIMEOUT, function()
        finish(nil, "Tempo esgotado. Tente de novo.")
    end)

    local mode = AI.mode or "medio"
    local instructions = system .. "\n\n" .. RULES[curLang()][mode]

    local input = {}
    for _, c in ipairs(contents) do
        local t = {}
        for _, p in ipairs(c.parts or {}) do
            if type(p.text) == "string" then table.insert(t, p.text) end
        end
        table.insert(input, {
            role = (c.role == "model") and "assistant" or "user",
            content = table.concat(t, "\n"),
        })
    end

    task.spawn(function()
        local ok, res = pcall(httpRequest, {
            Url = MODEL_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. API_KEY,
            },
            Body = HttpService:JSONEncode({
                model = MODEL_NAME,
                instructions = instructions,
                input = input,
                max_output_tokens = TOKENS[mode],
                store = false,
            }),
        })
        if not ok or type(res) ~= "table" then
            return finish(nil, "Sem resposta do executor. Ele precisa ter a função request.")
        end
        local okj, data = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
        if not okj or type(data) ~= "table" then
            return finish(nil, "Resposta inválida (HTTP " .. tostring(res.StatusCode) .. ").")
        end
        if data.error then
            local emsg = type(data.error) == "table" and data.error.message or data.error
            return finish(nil, "API: " .. tostring(emsg))
        end
        local out = {}
        if type(data.output) == "table" then
            for _, item in ipairs(data.output) do
                if item.type == "message" and type(item.content) == "table" then
                    for _, c in ipairs(item.content) do
                        if c.type == "output_text" and type(c.text) == "string" then
                            table.insert(out, c.text)
                        end
                    end
                end
            end
        end
        local text = table.concat(out)
        if text == "" and type(data.output_text) == "string" then
            text = data.output_text
        end
        if text == "" then
            local why = (data.incomplete_details and data.incomplete_details.reason) or data.status or "vazio"
            return finish(nil, "A IA não respondeu (" .. tostring(why) .. ").")
        end
        finish(text)
    end)
end

