local function explode(parent, cx, cy)
    local ring = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 30,
    }, parent)
    local ringStroke = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }, ring)
    TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(180, 180),
    }):Play()
    TweenService:Create(ringStroke, TweenInfo.new(0.45), { Transparency = 1 }):Play()
    Debris:AddItem(ring, 0.6)

    for i = 1, 16 do
        local s = math.random(2, 4)
        local p = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(s, s),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 31,
        }, parent)
        local a = math.rad(i * 22.5 + math.random(-6, 6))
        local d = math.random(40, 100)
        TweenService:Create(p, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.fromOffset(cx + math.cos(a) * d, cy + math.sin(a) * d),
            BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1),
        }):Play()
        Debris:AddItem(p, 0.7)
    end
end

local function sendToChat(msg)
    msg = trim200(msg)
    local ok = false
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = TextChatService:FindFirstChild("TextChannels")
        local gen = ch and ch:FindFirstChild("RBXGeneral")
        if gen then ok = pcall(function() gen:SendAsync(msg) end) end
    else
        local ev = RS:FindFirstChild("DefaultChatSystemChatEvents")
        local say = ev and ev:FindFirstChild("SayMessageRequest")
        if say then ok = pcall(function() say:FireServer(msg, "All") end) end
    end
    return ok
end

local function isNearBottom(sf)
    return sf.CanvasPosition.Y >= sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y - 40
end
local function scrollToBottom(sf)
    task.delay(0.05, function()
        if sf.Parent then
            sf.CanvasPosition = Vector2.new(0, math.max(0, sf.AbsoluteCanvasSize.Y - sf.AbsoluteWindowSize.Y))
        end
    end)
end

