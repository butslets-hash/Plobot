local function theme() return THEMES[THEME or "preto"] or THEMES.preto end

local gui
local regs = {}

local function paintBtn(b)
    local t = theme()
    local on = b:GetAttribute("on") == true
    b.BackgroundColor3 = on and t.accent or t.btn
    b.BackgroundTransparency = on and 0 or (t.btnT or 0)
    b.TextColor3 = on and t.accentText or t.btnText
end

local function setOn(b, v)
    b:SetAttribute("on", v and true or false)
    paintBtn(b)
end

local function applyRole(o, role)
    local t = theme()
    if role == "bg" then
        o.BackgroundColor3 = t.bg
        o.BackgroundTransparency = t.bgT or 0
    elseif role == "panel" then
        o.BackgroundColor3 = t.panel
        o.BackgroundTransparency = t.panelT or 0
    elseif role == "text" then
        o.TextColor3 = t.text
    elseif role == "muted" then
        o.TextColor3 = t.muted
    elseif role == "border" then
        o.Color = t.border
    elseif role == "btn" then
        paintBtn(o)
    end
end

local function applyEntry(e)
    if not gui or not e.o:IsDescendantOf(gui) then return false end
    if e.fn then e.fn(e.o) end
    if e.key then e.o.Text = L(e.key) end
    applyRole(e.o, e.role)
    return true
end

local function reg(o, role, key, fn)
    local e = { o = o, role = role, key = key, fn = fn }
    table.insert(regs, e)
    applyEntry(e)
    return o
end

local function applyAll()
    local alive = {}
    for _, e in ipairs(regs) do
        if applyEntry(e) then table.insert(alive, e) end
    end
    regs = alive
end

local function frame(parent, role, props)
    return reg(new("Frame", props, parent), role)
end

local function label(parent, role, props, key, fn)
    return reg(new("TextLabel", props, parent), role, key, fn)
end

local function strokeR(o)
    local s = new("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
    return reg(s, "border")
end

local function button(parent, props, key, fn)
    local defaults = {
        AutoButtonColor = false, BorderSizePixel = 0, Font = Enum.Font.GothamBold,
        TextSize = 12, TextWrapped = true,
    }
    for k, v in pairs(props) do defaults[k] = v end
    local b = new("TextButton", defaults, parent)
    strokeR(b)
    reg(b, "btn", key, fn)
    b.MouseButton1Click:Connect(function() sfx(SONS.clique, 0.4) end)
    return b
end

local function copyTo(b, text, key)
    local ok = pcall(setclipboard, text)
    b.Text = ok and L("copied") or L("noClip")
    task.delay(1.2, function()
        if b.Parent then b.Text = L(key) end
    end)
end

