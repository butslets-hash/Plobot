local function trimHistory()
    while #history > 20 or (history[1] and history[1].role ~= "user") do
        table.remove(history, 1)
    end
end

local function digitarNoBalao(lbl, texto, cancelado, depois)
    local visivel = clean(texto)
    local ok, total = pcall(utf8.len, visivel)
    if not ok or not total then
        lbl.Text = visivel
        if depois then depois() end
        return
    end
    if total == 0 then
        if depois then depois() end
        return
    end

    local porTick = math.max(1, math.ceil(total / 260))
    local feitos = 0
    local tick = 0

    task.spawn(function()
        while feitos < total do
            if cancelado() then return end

            local pertoDoFim = isNearBottom(scroll)
            feitos = math.min(total, feitos + porTick)
            local fim = utf8.offset(visivel, feitos + 1)
            lbl.Text = fim and visivel:sub(1, fim - 1) or visivel

            tick = tick + 1
            if tick % 4 == 0 then sfx(SONS.digitar, 0.15) end
            if pertoDoFim then scrollToBottom(scroll) end
            task.wait(0.03)
        end

        if not cancelado() and depois then depois() end
    end)
end

local runNext
runNext = function()
    if working or #jobs == 0 or not running then return end
    working = true
    local job = table.remove(jobs, 1)
    local myEpoch = epoch
    local fila = #jobs
    waitRow = addBubble(L("thinking") .. (fila > 0 and (" · " .. L("queue") .. ": " .. fila) or "") .. "...", "sys")

    local snapshot = {}
    for i, h in ipairs(history) do snapshot[i] = h end
    table.insert(snapshot, { role = "user", parts = { { text = job.text } } })

    AI.ask(chatSystem(), snapshot, function(reply, err)
        if not running or myEpoch ~= epoch then return end
        if waitRow and waitRow.Parent then waitRow:Destroy() end
        waitRow = nil

        if reply then
            table.insert(history, { role = "user", parts = { { text = job.text } } })
            table.insert(history, { role = "model", parts = { { text = reply } } })
            trimHistory()
            sfx(SONS.msg, 0.4)
            if THEME == "halloween" then sfx(SONS.abobora, 0.3) end

            local row, lbl = addBubble(reply, "ai", false, true)
            digitarNoBalao(lbl, reply,
                function() return not running or myEpoch ~= epoch or not row.Parent end,
                function()
                    working = false
                    runNext()
                end)
        else
            working = false
            addBubble(L("err") .. ": " .. tostring(err), "sys")
            runNext()
        end
    end)
end

